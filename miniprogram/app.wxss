page {
  background-color: #FFF5F8;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1C1C1E;
}

button { background: initial; }
button:focus { outline: 0; }
button::after { border: none; }

.page-container {
  padding: 32rpx;
  min-height: 100vh;
  background: #FFF5F8;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.10);
  margin-bottom: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB);
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  width: 100%;
  display: block;
}

.btn-secondary {
  background: #FFF0F5;
  color: #FF6B9D;
  border-radius: 48rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: 2rpx solid #FFB3CC;
  width: 100%;
  display: block;
}

.btn-mint {
  background: linear-gradient(135deg, #4ECDC4, #44B8B0);
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  width: 100%;
  display: block;
}

.btn-disabled {
  background: #F2F2F7;
  color: #C7C7CC;
  border-radius: 48rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  width: 100%;
  display: block;
}

.text-pink    { color: #FF6B9D; }
.text-mint    { color: #4ECDC4; }
.text-yellow  { color: #FFD93D; }
.text-purple  { color: #C3A6FF; }
.text-orange  { color: #FF9500; }
.text-secondary { color: #8E8E93; }
.text-danger  { color: #FF3B30; }
.text-success { color: #34C759; }
.text-bold    { font-weight: 700; }
.text-center  { text-align: center; }

.flex-row     { display: flex; flex-direction: row; align-items: center; }
.flex-col     { display: flex; flex-direction: column; }
.flex-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.flex-center  { display: flex; align-items: center; justify-content: center; }
.flex-1       { flex: 1; }

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 20rpx;
}

.chip { display: inline-block; padding: 6rpx 20rpx; border-radius: 32rpx; font-size: 22rpx; font-weight: 600; }
.chip-pink   { background: #FFE8F0; color: #FF6B9D; }
.chip-mint   { background: #E8FAF8; color: #4ECDC4; }
.chip-yellow { background: #FFF8E0; color: #E6A800; }
.chip-purple { background: #F0EBFF; color: #9B7FE8; }
.chip-orange { background: #FFF3E0; color: #FF9500; }

.divider { height: 1rpx; background: #F2F2F7; margin: 24rpx 0; }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 80rpx 0; color: #8E8E93; font-size: 28rpx;
}
.empty-state .emoji { font-size: 80rpx; margin-bottom: 20rpx; }
