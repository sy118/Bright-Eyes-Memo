page { background: #FFF5F8; padding-bottom: 120rpx; }

.home-wrap { padding: 32rpx; }

/* 康复完成 */
.recovered-page { display: flex; flex-direction: column; align-items: center; padding-top: 80rpx; }
.recovered-emoji { font-size: 120rpx; text-align: center; margin-bottom: 24rpx; }
.recovered-title { font-size: 52rpx; font-weight: 800; color: #1C1C1E; margin-bottom: 16rpx; }
.recovered-sub { font-size: 30rpx; color: #FF6B9D; font-weight: 600; text-align: center; }
.recovered-sub2 { font-size: 26rpx; color: #8E8E93; text-align: center; margin-top: 8rpx; }
.mt32 { margin-top: 32rpx; }
.stat-row { display: flex; justify-content: space-around; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 52rpx; font-weight: 800; }
.stat-label { font-size: 24rpx; color: #8E8E93; margin-top: 8rpx; }

/* Header */
.home-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
}
.day-badge {
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB);
  color: #fff; border-radius: 32rpx;
  padding: 12rpx 28rpx; font-size: 26rpx; font-weight: 600;
  display: inline-block;
}
.day-num { font-size: 36rpx; font-weight: 800; }
.week-label { font-size: 24rpx; color: #8E8E93; margin-top: 10rpx; }
.settings-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; box-shadow: 0 4rpx 16rpx rgba(255,107,157,0.12);
}

/* 警示条 */
.warning-bar {
  background: #FFF0F0; color: #FF3B30; border-radius: 20rpx;
  padding: 18rpx 28rpx; font-size: 26rpx; margin-bottom: 24rpx;
  border-left: 6rpx solid #FF3B30;
}

/* 进度卡片 */
.progress-card { }
.progress-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 20rpx; }
.progress-left { display: flex; align-items: baseline; gap: 10rpx; }
.progress-pct { font-size: 64rpx; font-weight: 900; line-height: 1; }
.progress-label { font-size: 24rpx; color: #8E8E93; }
.progress-done-tag { font-size: 24rpx; color: #4ECDC4; font-weight: 700; background: #E8FAF8; padding: 8rpx 16rpx; border-radius: 20rpx; }
.progress-remain { font-size: 24rpx; color: #FF9500; font-weight: 600; }
.progress-bar-wrap { margin-bottom: 28rpx; }
.progress-bar-bg { height: 16rpx; background: #F2F2F7; border-radius: 8rpx; overflow: hidden; }
.progress-bar-fill { height: 100%; border-radius: 8rpx; transition: width 0.5s ease; }
.progress-stats { display: flex; width: 100%; justify-content: space-around; align-items: center; }
.pstat { display: flex; flex-direction: column; align-items: center; }
.pstat-num { font-size: 34rpx; font-weight: 800; }
.pstat-label { font-size: 22rpx; color: #8E8E93; margin-top: 6rpx; }
.pstat-divider { width: 1rpx; height: 48rpx; background: #F2F2F7; }

/* 药品卡片 */
.section-title { font-size: 30rpx; font-weight: 700; color: #1C1C1E; margin-bottom: 16rpx; }
.mt8 { margin-top: 8rpx; }
.med-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 20rpx rgba(255,107,157,0.08);
  transition: all 0.3s;
}
.med-done { background: #F0FFF8; }
.med-top { display: flex; align-items: center; margin-bottom: 16rpx; }
.med-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; }
.med-info { flex: 1; }
.flex-1 { flex: 1; }
.med-name { font-size: 30rpx; font-weight: 700; color: #1C1C1E; }
.med-count { display: flex; align-items: baseline; }
.count-done { font-size: 40rpx; font-weight: 800; }
.count-sep { font-size: 28rpx; color: #C7C7CC; margin: 0 4rpx; }
.count-total { font-size: 28rpx; color: #8E8E93; }
.count-unit { font-size: 22rpx; color: #8E8E93; margin-left: 4rpx; }
.med-progress-bar {
  height: 8rpx; background: #F2F2F7; border-radius: 4rpx;
  margin-bottom: 20rpx; overflow: hidden;
}
.med-progress-fill { height: 100%; border-radius: 4rpx; transition: width 0.4s ease; }
.med-bottom { display: flex; align-items: center; justify-content: space-between; }
.med-hint-text { font-size: 22rpx; color: #8E8E93; flex: 1; padding-right: 16rpx; }
.checkin-btn {
  background: linear-gradient(135deg, #4ECDC4, #44B8B0);
  color: #fff; border-radius: 40rpx; padding: 16rpx 28rpx;
  font-size: 24rpx; font-weight: 600; border: none; flex-shrink: 0;
}
.done-badge {
  background: #E8FAF8; color: #4ECDC4; border-radius: 40rpx;
  padding: 16rpx 24rpx; font-size: 24rpx; font-weight: 600;
}

/* 护理卡片网格 */
.care-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.care-card {
  flex: 1; min-width: calc(50% - 8rpx); box-sizing: border-box;
  background: #fff; border-radius: 24rpx; padding: 28rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,157,0.08);
  display: flex; flex-direction: column; align-items: center;
  border: 2rpx solid transparent; transition: all 0.2s;
}
.care-card-done {
  background: #F0FFF8; border-color: #4ECDC4;
}
.care-icon { font-size: 44rpx; margin-bottom: 10rpx; }
.care-label { font-size: 26rpx; font-weight: 700; color: #1C1C1E; margin-bottom: 6rpx; text-align: center; }
.care-desc { font-size: 20rpx; color: #8E8E93; text-align: center; line-height: 1.4; }
.care-content { flex: 1; }
.care-label { font-size: 28rpx; font-weight: 600; color: #1C1C1E; display: block; }
.care-desc { font-size: 22rpx; color: #8E8E93; display: block; margin-top: 4rpx; }
.divider { height: 1rpx; background: #F2F2F7; }

/* 庆祝弹窗 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.modal-box {
  background: #fff; border-radius: 36rpx; padding: 48rpx 40rpx;
  width: 600rpx; display: flex; flex-direction: column; align-items: center;
}
.modal-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.modal-title { font-size: 44rpx; font-weight: 800; color: #1C1C1E; margin-bottom: 16rpx; }
.modal-sub { font-size: 28rpx; color: #FF6B9D; font-weight: 600; text-align: center; }
.modal-sub2 { font-size: 24rpx; color: #8E8E93; text-align: center; margin-top: 8rpx; }
.mt24 { margin-top: 24rpx; }
