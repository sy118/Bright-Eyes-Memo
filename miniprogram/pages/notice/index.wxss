page { background: #FFF5F8; overflow-x: hidden; }

.notice-wrap {
  padding: 32rpx;
  padding-bottom: 60rpx;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 已阅读条 */
.read-bar {
  display: flex; align-items: center;
  background: #fff; border-radius: 24rpx; padding: 24rpx 28rpx;
  margin-bottom: 32rpx; box-shadow: 0 4rpx 20rpx rgba(255,107,157,0.08);
  border: 2rpx solid #FFB3CC;
  box-sizing: border-box;
}
.read-bar.read-done { background: #F0FFF8; border-color: #4ECDC4; }
.read-check {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  border: 3rpx solid #E5E5EA; margin-right: 20rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.read-check.checked { background: #4ECDC4; border-color: #4ECDC4; }
.check-mark { color: #fff; font-size: 26rpx; font-weight: 700; }
.read-label { font-size: 26rpx; font-weight: 600; color: #1C1C1E; flex: 1; }

/* 章节 */
.notice-section { margin-bottom: 32rpx; }
.notice-title {
  font-size: 28rpx; font-weight: 800; color: #1C1C1E;
  margin-bottom: 16rpx; display: flex; align-items: center; gap: 8rpx;
}
.emergency-title { color: #FF3B30; }

/* 阶段卡片 */
.phase-card {
  background: #fff; border-radius: 24rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: 0 4rpx 20rpx rgba(255,107,157,0.08);
  box-sizing: border-box;
}
.phase-header { margin-bottom: 16rpx; }
.phase-badge {
  display: inline-block; background: linear-gradient(135deg, #FF6B9D, #FF8FAB);
  color: #fff; border-radius: 32rpx; padding: 8rpx 20rpx;
  font-size: 22rpx; font-weight: 700;
}
.med-row { display: flex; align-items: center; padding: 10rpx 0; }
.med-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 12rpx; flex-shrink: 0; }
.med-name { font-size: 26rpx; font-weight: 600; color: #1C1C1E; flex: 1; min-width: 0; }
.phase-hint {
  font-size: 22rpx; color: #8E8E93; margin-top: 12rpx;
  padding-top: 12rpx; border-top: 1rpx solid #F2F2F7;
  word-break: break-all; line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: #fff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255,107,157,0.08);
  box-sizing: border-box;
}
.notice-item { display: flex; align-items: flex-start; padding: 10rpx 0; }
.item-dot { font-size: 24rpx; margin-right: 12rpx; flex-shrink: 0; line-height: 1.7; }
.item-text { font-size: 24rpx; color: #3C3C3E; line-height: 1.7; flex: 1; min-width: 0; word-break: break-all; }
.divider { height: 1rpx; background: #F2F2F7; margin: 8rpx 0; }

/* 运动限制 */
.sport-row { padding: 14rpx 0; }
.sport-period { font-size: 24rpx; font-weight: 700; color: #FF6B9D; margin-bottom: 6rpx; }
.sport-rule { font-size: 24rpx; color: #3C3C3E; line-height: 1.7; word-break: break-all; }

/* 紧急就医 */
.emergency-card { border: 2rpx solid #FF3B30; background: #FFF5F5; }
.emergency-tip {
  font-size: 24rpx; font-weight: 700; color: #FF3B30;
  margin-bottom: 16rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #FFD0D0;
}

/* chip */
.chip { display: inline-block; padding: 4rpx 16rpx; border-radius: 32rpx; font-size: 20rpx; font-weight: 600; flex-shrink: 0; }
.chip-pink { background: #FFE8F0; color: #FF6B9D; }
.text-mint { color: #4ECDC4; }
.text-danger { color: #FF3B30; }

/* 免责声明 */
.disclaimer {
  font-size: 20rpx; color: #C7C7CC; text-align: center;
  padding: 32rpx 20rpx; line-height: 1.6; word-break: break-all;
}
