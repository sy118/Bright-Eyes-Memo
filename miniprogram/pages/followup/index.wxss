page { background: #FFF5F8; overflow-x: hidden; }

.followup-wrap {
  padding: 32rpx;
  padding-bottom: 60rpx;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.fu-header { margin-bottom: 32rpx; }
.fu-title { font-size: 36rpx; font-weight: 800; color: #1C1C1E; margin-bottom: 8rpx; }
.fu-sub { font-size: 24rpx; color: #8E8E93; }

/* 复查卡片 - 上下布局 */
.fu-card {
  background: #fff; border-radius: 24rpx; padding: 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 20rpx rgba(255,107,157,0.08);
  border-left: 6rpx solid #F2F2F7;
  box-sizing: border-box;
}
.fu-done  { background: #F0FFF8; border-left-color: #4ECDC4; }
.fu-today { background: #FFF0F5; border-left-color: #FF6B9D; }
.fu-urgent { border-left-color: #FF9500; }

/* 上方信息行 */
.fu-card-top { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.fu-icon { font-size: 36rpx; margin-right: 16rpx; flex-shrink: 0; line-height: 1.4; }
.fu-info { flex: 1; min-width: 0; }
.fu-label { font-size: 28rpx; font-weight: 700; color: #1C1C1E; display: block; margin-bottom: 6rpx; }
.fu-date  { font-size: 22rpx; color: #8E8E93; display: block; margin-bottom: 6rpx; }
.fu-status { font-size: 22rpx; font-weight: 600; display: block; }

.text-mint     { color: #4ECDC4; }
.text-pink     { color: #FF6B9D; }
.text-danger   { color: #FF3B30; }
.text-orange   { color: #FF9500; }
.text-secondary { color: #8E8E93; }

/* 下方按钮行 */
.fu-card-bottom { }
.fu-btn {
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB);
  color: #fff; border-radius: 40rpx; padding: 20rpx 0;
  font-size: 26rpx; font-weight: 600; border: none;
  width: 100%; text-align: center; display: block;
}
.fu-result-wrap {
  background: #E8FAF8; border-radius: 40rpx; padding: 20rpx;
  text-align: center;
}
.fu-result-label { font-size: 26rpx; color: #4ECDC4; font-weight: 600; }

/* 弹窗 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.modal-box {
  background: #fff; border-radius: 32rpx; padding: 40rpx 32rpx;
  width: calc(100vw - 80rpx);
  max-height: 80vh; overflow-y: auto;
  box-sizing: border-box;
}
.modal-title { font-size: 30rpx; font-weight: 800; color: #1C1C1E; margin-bottom: 8rpx; }
.modal-label { font-size: 24rpx; color: #FF6B9D; font-weight: 600; margin-bottom: 24rpx; }

.result-form { margin-bottom: 24rpx; }
.form-row { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #8E8E93; display: block; margin-bottom: 12rpx; font-weight: 600; }
.form-input {
  background: #F8F8F8; border-radius: 20rpx; padding: 28rpx 24rpx;
  font-size: 30rpx; color: #1C1C1E; width: 100%; box-sizing: border-box;
  border: 2rpx solid #F0F0F0; min-height: 88rpx;
}
.form-textarea {
  background: #F8F8F8; border-radius: 20rpx; padding: 28rpx 24rpx;
  font-size: 30rpx; color: #1C1C1E; width: 100%; box-sizing: border-box;
  min-height: 160rpx; border: 2rpx solid #F0F0F0; line-height: 1.6;
}

.modal-btns { display: flex; gap: 16rpx; }
.btn-half { flex: 1; }
.btn-primary {
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB); color: #fff;
  border-radius: 40rpx; padding: 24rpx 0; font-size: 26rpx; font-weight: 600;
  text-align: center; border: none; width: 100%; display: block;
}
.btn-secondary {
  background: #FFF0F5; color: #FF6B9D; border-radius: 40rpx; padding: 24rpx 0;
  font-size: 26rpx; font-weight: 600; text-align: center;
  border: 2rpx solid #FFB3CC; width: 100%; display: block;
}
.mt24 { margin-top: 24rpx; }

.result-view { margin-bottom: 24rpx; }
.rv-row { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid #F2F2F7; }
.rv-label { font-size: 24rpx; color: #8E8E93; width: 140rpx; flex-shrink: 0; }
.rv-val { font-size: 24rpx; color: #1C1C1E; flex: 1; min-width: 0; word-break: break-all; }
