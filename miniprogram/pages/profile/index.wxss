page { background: #FFF5F8; overflow-x: hidden; }

.profile-wrap {
  padding: 32rpx;
  padding-bottom: 60rpx;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.card {
  background: #fff; border-radius: 28rpx; padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255,107,157,0.10); margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* 统计看板 */
.stats-title { font-size: 28rpx; font-weight: 700; color: #1C1C1E; margin-bottom: 24rpx; }
.stats-grid { display: flex; justify-content: space-around; }
.stats-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.stats-num { font-size: 44rpx; font-weight: 800; line-height: 1; }
.stats-label { font-size: 20rpx; color: #8E8E93; margin-top: 8rpx; text-align: center; }
.stats-unit { font-size: 18rpx; color: #C7C7CC; }
.text-pink   { color: #FF6B9D; }
.text-mint   { color: #4ECDC4; }
.text-purple { color: #C3A6FF; }

/* 日历 */
.cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.cal-title { font-size: 28rpx; font-weight: 700; color: #1C1C1E; }
.cal-nav {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: #FFF0F5; color: #FF6B9D; font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.cal-weekdays { display: flex; margin-bottom: 8rpx; }
.cal-wd { flex: 1; text-align: center; font-size: 20rpx; color: #8E8E93; font-weight: 600; }

/* 日历格子：用 padding-bottom 代替 aspect-ratio，兼容性更好 */
.cal-grid { display: flex; flex-wrap: wrap; width: 100%; }
.cal-cell {
  width: 14.2857%;
  padding-bottom: 14.2857%;
  position: relative;
  box-sizing: border-box;
}
.cal-cell-inner {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.cal-cell.empty .cal-cell-inner { }
.cal-day { font-size: 22rpx; color: #1C1C1E; line-height: 1; }
.cal-mark { font-size: 18rpx; line-height: 1; margin-top: 2rpx; }
.today-dot { color: #FF6B9D; font-size: 20rpx; }
.cal-cell.done .cal-day { color: #4ECDC4; font-weight: 700; }
.cal-cell.miss .cal-day { color: #FF3B30; }
.cal-cell.today .cal-day { color: #FF6B9D; font-weight: 800; }

.cal-legend { display: flex; justify-content: center; gap: 32rpx; margin-top: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 6rpx; }
.legend-label { font-size: 20rpx; color: #8E8E93; }

/* 扩展功能 */
.section-title { font-size: 28rpx; font-weight: 700; color: #1C1C1E; margin-bottom: 20rpx; }
.coming-item { display: flex; align-items: center; padding: 16rpx 0; }
.coming-icon { font-size: 40rpx; margin-right: 16rpx; flex-shrink: 0; }
.coming-info { flex: 1; min-width: 0; }
.coming-name { font-size: 26rpx; font-weight: 600; color: #1C1C1E; display: block; }
.coming-desc { font-size: 20rpx; color: #8E8E93; display: block; margin-top: 4rpx; }
.coming-tag {
  background: #F2F2F7; color: #C7C7CC; border-radius: 20rpx;
  padding: 6rpx 16rpx; font-size: 20rpx; flex-shrink: 0;
}
.divider { height: 1rpx; background: #F2F2F7; margin: 8rpx 0; }
